# ---- 服务基础 ----
# JWT 签名密钥，生产环境务必修改
JWT_SECRET=please-change-me-in-production

# ---- LLM（OpenAI 兼容协议）----
# 留空 LLM_API_KEY / LLM_BASE_URL => 自动启用内置规则引擎（演示模式），功能完整可用
# 示例（DeepSeek）：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=deepseek-chat
# 其他兼容服务：通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 (qwen-plus)
#              Moonshot https://api.moonshot.cn/v1 (moonshot-v1-8k)
#              OpenAI  https://api.openai.com/v1 (gpt-4o-mini)
#
# 火山方舟 Agent Plan / Coding Plan 套餐（注意：套餐 Key 与标准 Key 的端点不同！）
#   套餐专属 Key（ark- 开头，订阅页获取）+ 套餐端点 + 通用模型别名：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
#   LLM_API_KEY=ark-xxxxxxxx
#   LLM_MODEL=ark-code-latest
#   警告：套餐 Key 错用标准端点 https://ark.cn-beijing.volces.com/api/v3 会认证失败，
#        且可能产生额外费用；具体模型名（minimax-m2.7 / glm-5.3 / kimi-k2.6 等）见方舟文档
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# ---- Embedding（可选）----
# 单独配置后，知识块与题目向量化使用真实 Embedding 模型；否则使用内置确定性向量
# （中文 n-gram TF-IDF 哈希，检索与去重仍可用，质量低于商业模型）
# 示例（SiliconFlow，国内可直连）：
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 存储 ----
# SQLite 关系数据库（切换 PostgreSQL 只需改此 URL，ORM 已屏蔽差异）
DATABASE_URL=sqlite:///./data/interview_trainer.db
# ChromaDB 向量库持久化目录
CHROMA_DIR=./data/chroma

# ---- 出题参数 ----
CHUNK_TARGET_SIZE=400
CHUNK_MAX_SIZE=600
QUESTION_DEDUP_THRESHOLD=0.95
EMBEDDING_DIM=384
