# ---------- Docker Compose 部署配置 ----------
# 用法：cp .env.example .env，按需修改后 docker compose up -d --build
#
# 必填：JWT 签名密钥（强随机，至少 32 位）。
# 留空或沿用示例占位值 => 容器以 APP_ENV=production 拒绝启动（安全红线）。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 对外端口：浏览器访问 http://localhost:${APP_PORT}
APP_PORT=8080

# ---------- LLM（OpenAI 兼容协议）----------
# 全部留空 => 演示模式（内置规则引擎），功能完整可用，无需任何 Key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- Embedding（可选）----------
# 留空 => 内置确定性向量（中文 n-gram 哈希），检索/去重仍可用
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
